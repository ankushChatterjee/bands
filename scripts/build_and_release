#!/bin/sh
set -eu

usage() {
    printf '%s\n' "Usage: $0 RELEASE_TAG" >&2
    printf '%s\n' "Examples: $0 alpha | $0 beta.2 | $0 release-candidate" >&2
    printf '%s\n' "Uses the local code-signing identity 'Apple Development: ac.ankush15@gmail.com (J6G9D2S38S)' by default." >&2
    printf '%s\n' "Override with: SELF_SIGNING_IDENTITY='Your local code-signing identity'" >&2
    exit 2
}

[ "$#" -eq 1 ] || usage
release_tag=$1

git check-ref-format --allow-onelevel "refs/tags/$release_tag" >/dev/null 2>&1 || {
    printf 'Invalid Git tag: %s\n' "$release_tag" >&2
    exit 2
}

case "$release_tag" in
    */*) artifact_label=$(printf '%s' "$release_tag" | tr '/' '-') ;;
    *) artifact_label=$release_tag ;;
esac

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root_dir"

signing_identity=${SELF_SIGNING_IDENTITY:-Apple Development: ac.ankush15@gmail.com (J6G9D2S38S)}
notary_profile=${NOTARYTOOL_PROFILE:-}

git rev-parse --show-toplevel >/dev/null 2>&1 || {
    printf '%s\n' 'Not inside a Git repository.' >&2
    exit 1
}

branch=$(git symbolic-ref --quiet --short HEAD) || {
    printf '%s\n' 'Release must run from a named branch, not a detached HEAD.' >&2
    exit 1
}

if [ -n "$(git status --porcelain)" ]; then
    printf '%s\n' 'Release requires a clean, committed worktree. Commit staged changes first.' >&2
    exit 1
fi

tag="$release_tag"
if git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
    printf 'Tag already exists: %s\n' "$tag" >&2
    exit 1
fi

build_number=$(git rev-list --count HEAD)
[ "$build_number" -gt 0 ] || build_number=1

release_dir="$root_dir/.build/releases/$artifact_label"
archive_path="$release_dir/lanes.xcarchive"
app_path="$archive_path/Products/Applications/lanes.app"
dmg_path="$release_dir/lanes-$artifact_label.dmg"
staging_dir="$release_dir/dmg-root"

mkdir -p "$release_dir"
rm -rf "$staging_dir"

"$root_dir/scripts/generate-placeholder-icon.sh"

printf 'Building %s from branch %s at build %s...\n' "$release_tag" "$branch" "$build_number"
xcodebuild \
    -project "$root_dir/lanes.xcodeproj" \
    -scheme lanes \
    -configuration Release \
    -archivePath "$archive_path" \
    MARKETING_VERSION="$release_tag" \
    CURRENT_PROJECT_VERSION="$build_number" \
    CODE_SIGNING_ALLOWED=NO \
    archive

[ -d "$app_path" ] || { printf '%s\n' 'Archive did not contain lanes.app.' >&2; exit 1; }

printf 'Self-signing lanes.app with %s...\n' "$signing_identity"
codesign --force --deep --options runtime --timestamp=none --sign "$signing_identity" "$app_path"
codesign --verify --deep --strict --verbose=2 "$app_path"

if [ -n "$notary_profile" ]; then
    printf 'Submitting app for notarization with profile %s...\n' "$notary_profile"
    xcrun notarytool submit "$app_path" --keychain-profile "$notary_profile" --wait
    xcrun stapler staple "$app_path"
    codesign --verify --deep --strict --verbose=2 "$app_path"
fi

mkdir -p "$staging_dir"
ditto "$app_path" "$staging_dir/lanes.app"
ln -s /Applications "$staging_dir/Applications"
hdiutil create \
    -volname "lanes $artifact_label" \
    -srcfolder "$staging_dir" \
    -ov \
    -format UDZO \
    "$dmg_path"

printf 'Self-signing release DMG with %s...\n' "$signing_identity"
codesign --force --timestamp=none --sign "$signing_identity" "$dmg_path"
codesign --verify --strict --verbose=2 "$dmg_path"

if [ -n "$notary_profile" ]; then
    printf 'Submitting DMG for notarization with profile %s...\n' "$notary_profile"
    xcrun notarytool submit "$dmg_path" --keychain-profile "$notary_profile" --wait
    xcrun stapler staple "$dmg_path"
    codesign --verify --strict --verbose=2 "$dmg_path"
fi

git tag -a "$tag" -m "Release lanes $release_tag"

printf '\nRelease complete.\n'
printf 'Branch:   %s\n' "$branch"
printf 'Tag:      %s\n' "$tag"
printf 'Version:  %s\n' "$release_tag"
printf 'Build:    %s\n' "$build_number"
printf 'DMG:      %s\n' "$dmg_path"
